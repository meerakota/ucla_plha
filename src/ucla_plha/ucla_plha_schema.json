{
    "$schema": "http://json-schema.org/draft-04/schema",
    "id": "resource:/schemas/ucla_plha_schema.json",
    "type": "object",
    "required": [
        "site",
        "source_models",
        "ground_motion_models",
        "output"
    ],
    "properties": {
        "site": {
            "type": "object",
            "properties": {
                "latitude": {
                    "type": "number"
                },
                "longitude": {
                    "type": "number"
                },
                "elevation": {
                    "type": "number"
                },
                "vs30": {
                    "type": "number"
                },
                "measured_vs30": {
                    "type": "boolean"
                },
                "z1p0": {
                    "type": "number"
                },
                "z2p5": {
                    "type": "number"
                },
                "zsed": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "description": "Thickness of the Atlantic and Gulf coastal plain sediments (km) for the NGA-East models (pygmm depth_sed); null for a site off the coastal plain. If omitted, the USGS NSHM value (Boyd 2023 model, as used by the USGS hazard service) is used, unless nshm_site_data is false"
                },
                "nshm_site_data": {
                    "type": "boolean",
                    "description": "Use the location-dependent site data of the USGS NSHM (default true): the coastal plain sediment thickness zsed (unless zsed is given) and, for sites inside the NSHM Coastal Plain CPA region, its stable crust ground motion model logic tree (with the Chapman and Guo 2021 coastal plain amplification models) for all stable crust source models that use the default trees"
                }
            },
            "additionalProperties": true,
            "required": [
                "latitude",
                "longitude",
                "elevation",
                "vs30"
            ]
        },
        "constraints": {
            "type": "object",
            "properties": {
                "dist_cutoff": {
                    "type": [
                        "number",
                        "object"
                    ],
                    "description": "Maximum distance (km), either a number for all source models or an object with a number for each tectonic region",
                    "properties": {
                        "active_crust": {
                            "type": "number"
                        },
                        "stable_crust": {
                            "type": "number"
                        },
                        "subduction_interface": {
                            "type": "number"
                        },
                        "subduction_slab": {
                            "type": "number"
                        }
                    }
                },
                "m_min": {
                    "type": "number"
                },
                "truncation_level": {
                    "type": "number",
                    "description": "Upper truncation of the ground motion distribution in standard deviations (nshmp-lib TRUNCATION_UPPER_ONLY; the USGS NSHM uses 3). Omit for no truncation."
                },
                "rupture_rx": {
                    "type": "string",
                    "enum": ["closest_section", "minimum"],
                    "description": "Rx and Rx1 of fault source ruptures with several fault segments: those of the segment closest to the site (smallest Rrup), as in nshmp-lib (default), or the minimum over the segments (ucla_plha 1.x)."
                },
                "fault_distances": {
                    "type": "string",
                    "enum": ["source_info", "triangles"],
                    "description": "Distances of fault source ruptures: as given by each source model's source_info.json (default; the NSHM23 Cascadia interface and CEUS fault models compute rJB, rRup, and rX from their nshmp-lib gridded surfaces, as nshmp-lib does), or from the triangles and rectangles of the fault segments for all models."
                },
                "section_rx": {
                    "type": "string",
                    "enum": ["source_info", "minimum", "extended_trace"],
                    "description": "Rx and Rx1 of a fault segment made of several planar pieces: as given by each source model's source_info.json (default; extended_trace for NSHM23 WUS, minimum for UCERF3), the minimum over the pieces, or, as in nshmp-lib, the distance to the upper edge of the whole segment extended along strike, positive on the dip side."
                }
            },
            "additionalProperties": false
        },
        "source_models": {
            "type": "object",
            "properties": {
                "fault_source_models": {
                    "type": "object",
                    "properties": {
                        "ucerf3_fm31": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "ucerf3_fm32": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "nshm23_wus": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "nshm23_cascadia_interface": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                },
                                "dist_cutoff": {
                                    "type": "number",
                                    "description": "maximum distance (km) for this source model (overrides constraints.dist_cutoff)"
                                },
                                "ground_motion_models": {
                                    "type": "object",
                                    "description": "ground motion models for this source model (overrides its tectonic region and source_info.json gmm_tree)"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "nshm23_ceus_fault": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                },
                                "dist_cutoff": {
                                    "type": "number",
                                    "description": "maximum distance (km) for this source model (overrides constraints.dist_cutoff)"
                                },
                                "ground_motion_models": {
                                    "type": "object",
                                    "description": "ground motion models for this source model (overrides its tectonic region and source_info.json gmm_tree)"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "nshm23_ceus_fault_cluster": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                },
                                "dist_cutoff": {
                                    "type": "number",
                                    "description": "maximum distance (km) for this source model (overrides constraints.dist_cutoff)"
                                },
                                "ground_motion_models": {
                                    "type": "object",
                                    "description": "ground motion models for this source model (overrides its tectonic region and source_info.json gmm_tree)"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "nshm23_cascadia_interface_cluster": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                },
                                "dist_cutoff": {
                                    "type": "number",
                                    "description": "maximum distance (km) for this source model (overrides constraints.dist_cutoff)"
                                },
                                "ground_motion_models": {
                                    "type": "object",
                                    "description": "ground motion models for this source model (overrides its tectonic region and source_info.json gmm_tree)"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "point_source_models": {
                    "type": "object",
                    "properties": {
                        "ucerf3_fm31_grid_sub_seis": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "ucerf3_fm31_grid_unassociated": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "ucerf3_fm32_grid_sub_seis": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "ucerf3_fm32_grid_unassociated": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "nshm23_wus_grid": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "nshm23_cascadia_slab": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                },
                                "dist_cutoff": {
                                    "type": "number",
                                    "description": "maximum distance (km) for this source model (overrides constraints.dist_cutoff)"
                                },
                                "ground_motion_models": {
                                    "type": "object",
                                    "description": "ground motion models for this source model (overrides its tectonic region and source_info.json gmm_tree)"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "nshm23_ceus_zone": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                },
                                "dist_cutoff": {
                                    "type": "number",
                                    "description": "maximum distance (km) for this source model (overrides constraints.dist_cutoff)"
                                },
                                "ground_motion_models": {
                                    "type": "object",
                                    "description": "ground motion models for this source model (overrides its tectonic region and source_info.json gmm_tree)"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "nshm23_ceus_grid": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                },
                                "dist_cutoff": {
                                    "type": "number",
                                    "description": "maximum distance (km) for this source model (overrides constraints.dist_cutoff)"
                                },
                                "ground_motion_models": {
                                    "type": "object",
                                    "description": "ground motion models for this source model (overrides its tectonic region and source_info.json gmm_tree)"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        },
                        "nshm23_ceus_grid_system": {
                            "type": "object",
                            "properties": {
                                "weight": {
                                    "type": "number"
                                },
                                "dist_cutoff": {
                                    "type": "number",
                                    "description": "maximum distance (km) for this source model (overrides constraints.dist_cutoff)"
                                },
                                "ground_motion_models": {
                                    "type": "object",
                                    "description": "ground motion models for this source model (overrides its tectonic region and source_info.json gmm_tree)"
                                }
                            },
                            "required": [
                                "weight"
                            ],
                            "additionalProperties": false
                        }
                    }
                }
            },
            "additionalProperties": false
        },
        "ground_motion_models": {
            "type": "object",
            "description": "Either an object with one key per tectonic region (active_crust, stable_crust, subduction_interface, subduction_slab), or, in the earlier format, an object of ground motion models that are used for the active crust",
            "properties": {
                "active_crust": {
                    "type": [
                        "object",
                        "string"
                    ],
                    "description": "Ground motion models of the tectonic region: an object of {model name: {weight}} (ucla_plha models ask14, bssa14, cb14, cy14, idriss14; nshmp-lib Gmm ids provided by pygmm; or pygmm class names, with optional options and scenario objects), or \"default\" for the USGS NSHM models of the region"
                },
                "stable_crust": {
                    "type": [
                        "object",
                        "string"
                    ],
                    "description": "Ground motion models of the tectonic region: an object of {model name: {weight}} (ucla_plha models ask14, bssa14, cb14, cy14, idriss14; nshmp-lib Gmm ids provided by pygmm; or pygmm class names, with optional options and scenario objects), or \"default\" for the USGS NSHM models of the region"
                },
                "subduction_interface": {
                    "type": [
                        "object",
                        "string"
                    ],
                    "description": "Ground motion models of the tectonic region: an object of {model name: {weight}} (ucla_plha models ask14, bssa14, cb14, cy14, idriss14; nshmp-lib Gmm ids provided by pygmm; or pygmm class names, with optional options and scenario objects), or \"default\" for the USGS NSHM models of the region"
                },
                "subduction_slab": {
                    "type": [
                        "object",
                        "string"
                    ],
                    "description": "Ground motion models of the tectonic region: an object of {model name: {weight}} (ucla_plha models ask14, bssa14, cb14, cy14, idriss14; nshmp-lib Gmm ids provided by pygmm; or pygmm class names, with optional options and scenario objects), or \"default\" for the USGS NSHM models of the region"
                },
                "bssa14": {
                    "type": "object",
                    "properties": {
                        "weight": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "weight"
                    ],
                    "additionalProperties": false
                },
                "cy14": {
                    "type": "object",
                    "properties": {
                        "weight": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "weight"
                    ],
                    "additionalProperties": false
                },
                "cb14": {
                    "type": "object",
                    "properties": {
                        "weight": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "weight"
                    ],
                    "additionalProperties": false
                },
                "ask14": {
                    "type": "object",
                    "properties": {
                        "weight": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "weight"
                    ],
                    "additionalProperties": false
                },
                "idriss14": {
                    "type": "object",
                    "properties": {
                        "weight": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "weight"
                    ],
                    "additionalProperties": false
                }
            },
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "weight": {
                        "type": "number"
                    },
                    "options": {
                        "type": "object"
                    },
                    "scenario": {
                        "type": "object"
                    }
                },
                "required": [
                    "weight"
                ]
            }
        },
        "liquefaction_models": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "boulanger_idriss_2012": {
                    "type": "object",
                    "properties": {
                        "n160": {
                            "type": "number"
                        },
                        "fc": {
                            "type": "number"
                        },
                        "sigmav": {
                            "type": "number"
                        },
                        "sigmavp": {
                            "type": "number"
                        },
                        "depth": {
                            "type": "number"
                        },
                        "pa": {
                            "type": "number"
                        },
                        "weight": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "n160",
                        "fc",
                        "sigmav",
                        "sigmavp",
                        "depth",
                        "pa",
                        "weight"
                    ],
                    "additionalProperties": false
                },
                "boulanger_idriss_2016": {
                    "type": "object",
                    "properties": {
                        "qc1Ncs": {
                            "type": "number"
                        },
                        "sigmav": {
                            "type": "number"
                        },
                        "sigmavp": {
                            "type": "number"
                        },
                        "depth": {
                            "type": "number"
                        },
                        "pa": {
                            "type": "number"
                        },
                        "weight": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "qc1Ncs",
                        "sigmav",
                        "sigmavp",
                        "depth",
                        "pa",
                        "weight"
                    ],
                    "additionalProperties": false
                },
                "cetin_et_al_2018": {
                    "type": "object",
                    "properties": {
                        "n160": {
                            "type": "number"
                        },
                        "fc": {
                            "type": "number"
                        },
                        "vs12": {
                            "type": "number"
                        },
                        "sigmav": {
                            "type": "number"
                        },
                        "sigmavp": {
                            "type": "number"
                        },
                        "depth": {
                            "type": "number"
                        },
                        "pa": {
                            "type": "number"
                        },
                        "weight": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "n160",
                        "fc",
                        "vs12",
                        "sigmav",
                        "sigmavp",
                        "depth",
                        "pa",
                        "weight"
                    ],
                    "additionalProperties": false
                },
                "moss_et_al_2006": {
                    "properties": {
                        "qc": {
                            "type": "number"
                        },
                        "fs": {
                            "type": "number"
                        },
                        "sigmav": {
                            "type": "number"
                        },
                        "sigmavp": {
                            "type": "number"
                        },
                        "depth": {
                            "type": "number"
                        },
                        "pa": {
                            "type": "number"
                        },
                        "weight": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "qc",
                        "fs",
                        "sigmav",
                        "sigmavp",
                        "depth",
                        "pa",
                        "weight"
                    ],
                    "additionalProperties": false
                },
                "ngl_smt_2024": {
                    "type": "object",
                    "properties": {
                        "ztop": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "zbot": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "qc1Ncs": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "Ic": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "sigmav": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "sigmavp": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "Ksat": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "pa": {
                            "type": "number"
                        },
                        "weight": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "ztop",
                        "zbot",
                        "qc1Ncs",
                        "Ic",
                        "sigmav",
                        "sigmavp",
                        "Ksat",
                        "pa",
                        "weight"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "output": {
            "type": "object",
            "properties": {
                "psha": {
                    "type": "object",
                    "properties": {
                        "pga": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "disaggregation": {
                            "type": "object",
                            "properties": {
                                "magnitude_bin_edges": {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "distance_bin_edges": {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "epsilon_bin_edges": {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "distance_metric": {
                                    "enum": ["default", "rrup", "rjb"],
                                    "description": "Distance used for the distance bins: default (rjb if any ground motion model of the source model uses rjb, otherwise rrup), rrup (as the USGS NSHM disaggregation, nshmp-lib Disaggregator), or rjb"
                                },
                                "cluster_attribution": {
                                    "enum": ["branch", "gmm"],
                                    "description": "How the hazard of a cluster (cluster source models) is shared among its ruptures: branch (default; in proportion to the weighted exceedance probability w_i P_i within each ground motion branch) or gmm (as the USGS NSHM disaggregation, nshmp-lib Disaggregator: in proportion to w_b w_i P_ib over all branches b of each ground motion model)"
                                },
                                "means": {
                                    "type": "boolean",
                                    "description": "Also output the contribution and the mean magnitude, distance, and epsilon of the binned hazard (in total and, with source_model_hazard, per source model)"
                                }
                            },
                            "required": [
                                "magnitude_bin_edges",
                                "distance_bin_edges",
                                "epsilon_bin_edges"
                            ],
                            "additionalProperties": false
                        },
                        "source_model_hazard": {
                            "type": "boolean",
                            "description": "Also output the weighted hazard curve of each source model (and of the clusters of cluster models)"
                        }
                    }
                },
                "plha": {
                    "type": "object",
                    "properties": {
                        "fsl": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "disaggregation": {
                            "type": "object",
                            "properties": {
                                "magnitude_bin_edges": {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "distance_bin_edges": {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "epsilon_bin_edges": {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "distance_metric": {
                                    "enum": ["default", "rrup", "rjb"],
                                    "description": "Distance used for the distance bins: default (rjb if any ground motion model of the source model uses rjb, otherwise rrup), rrup (as the USGS NSHM disaggregation, nshmp-lib Disaggregator), or rjb"
                                }
                            },
                            "required": [
                                "magnitude_bin_edges",
                                "distance_bin_edges",
                                "epsilon_bin_edges"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "outputfile": {
                    "type": "string"
                }
            }
        }
    }
}
